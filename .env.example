# Copy this file to .env and replace the placeholders locally.
# Never add keys, connection strings, SAS tokens, or client secrets here.

# Azure region
AZURE_LOCATION=uksouth
AZURE_SUBSCRIPTION_ID=<subscription-id>
AZURE_TENANT_ID=<tenant-id>
AZURE_RESOURCE_GROUP=<resource-group-name>
# Local: interactive_browser. Railway: service_principal.
AZURE_AUTH_METHOD=interactive_browser
AZURE_CLIENT_ID=<application-client-id>
# Set AZURE_CLIENT_SECRET only in Railway or another secret store.
AZURE_CLIENT_SECRET=<application-client-secret>

# Azure Blob Storage
AZURE_STORAGE_ACCOUNT_NAME=<storage-account-name>
AZURE_STORAGE_ACCOUNT_URL=https://<storage-account-name>.blob.core.windows.net
AZURE_STORAGE_SOURCE_CONTAINER=source-documents
AZURE_STORAGE_PROCESSED_CONTAINER=processed-documents
AZURE_STORAGE_EVALUATION_CONTAINER=evaluation-data

# Azure AI Search
AZURE_SEARCH_SERVICE_NAME=<search-service-name>
AZURE_SEARCH_ENDPOINT=https://<search-service-name>.search.windows.net
AZURE_SEARCH_INDEX_NAME=uol-finance-chunks-v1

# Microsoft Foundry
FOUNDRY_PROJECT_NAME=<project-name>
FOUNDRY_PROJECT_ENDPOINT=https://<foundry-resource>.services.ai.azure.com/api/projects/<project-name>
# OpenAI-compatible inference endpoint. Embeddings use this endpoint, not the project endpoint.
AZURE_OPENAI_ENDPOINT=https://<foundry-resource>.openai.azure.com
AZURE_CHAT_DEPLOYMENT=gpt-5-mini
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_EMBEDDING_DIMENSIONS=1536

# Serving API
API_ALLOWED_ORIGINS=https://kenjihilasak.github.io,http://localhost:4321
API_MAX_REQUESTS_PER_MINUTE=5
# Deliberate cost-control switch. Enable only after Railway is configured.
API_LIVE_ENABLED=false
